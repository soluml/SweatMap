{
  "name": "sweatmap",
  "description": "SweatMap takes in a series of UTF-8 strings and maps them to UTF-8 strings that are as small as possible while still being unique.",
  "version": "0.3.7",
  "author": {
    "name": "Benjamin Solum",
    "email": "benjamin@soluml.com",
    "url": "http://soluml.com"
  },
  "preferGlobal": true,
  "keywords": [
    "sweat",
    "sweatmap",
    "sweat map",
    "sweatmap javascript",
    "sweatmap.js",
    "minify",
    "obfuscate",
    "optimize",
    "css"
  ],
  "type": "module",
  "main": "dist/sweatmap.js",
  "exports": {
    ".": {
      "types": "./dist/sweatmap.d.ts",
      "default": "./dist/sweatmap.js"
    }
  },
  "types": "dist/sweatmap.d.ts",
  "files": [
    "dist"
  ],
  "readmeFilename": "README.md",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/soluml/sweatmap.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "typecheck": "tsc",
    "test": "node --test test/test.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}

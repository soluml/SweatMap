{
  "name": "sweatmap",
  "version": "0.4.0",
  "description": "SweatMap takes in a series of UTF-8 strings and maps them to UTF-8 strings that are as small as possible while still being unique.",
  "keywords": [
    "css",
    "minify",
    "obfuscate",
    "optimize",
    "sweat",
    "sweat map",
    "sweatmap",
    "sweatmap javascript",
    "sweatmap.js"
  ],
  "author": {
    "name": "Benjamin Solum",
    "email": "benjamin@soluml.com",
    "url": "http://soluml.com"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/soluml/sweatmap.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/sweatmap.js",
  "types": "dist/sweatmap.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sweatmap.d.ts",
      "default": "./dist/sweatmap.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "tsc",
    "test": "node --test test/test.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2"
  },
  "preferGlobal": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "readmeFilename": "README.md"
}
